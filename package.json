{
  "name": "pyospectui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "registry:build": "node scripts/build-registry.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "lint:taste": "node scripts/taste-lint.mjs",
    "check": "npm run theme:check && npm run lint:taste && node scripts/catalog-check.mjs && node --test scripts/geometry-check.test.mjs scripts/component-identity.test.mjs",
    "e2e:install": "bash scripts/e2e-install.sh",
    "check:geometry": "node scripts/geometry-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "~4.21.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
