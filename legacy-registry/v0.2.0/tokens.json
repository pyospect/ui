{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tokens",
  "title": "pyospect tokens",
  "description": "pyospect 토큰 이름(bg-surface-2, text-brand-ink...)과 고정 뉴트럴 값, one-line, glow, tabular 유틸리티예요. 브랜드와 상태색 값은 없어서, 테마를 넣기 전에는 brand, ok-fill 같은 색이 비어 있어요. 테마는 npx pyospectui나 @pyospect/theme으로 넣어요.",
  "cssVars": {
    "theme": {
      "default-transition-duration": "120ms",
      "default-transition-timing-function": "cubic-bezier(0, 0, 0.2, 1)",
      "color-bg": "var(--bg)",
      "color-surface": "var(--surface)",
      "color-surface-2": "var(--surface-2)",
      "color-surface-3": "var(--surface-3)",
      "color-text": "var(--text)",
      "color-text-2": "var(--text-2)",
      "color-text-3": "var(--text-3)",
      "color-line": "var(--line)",
      "color-glow": "var(--glow)",
      "color-scrim": "var(--scrim)",
      "color-skeleton": "var(--skeleton)",
      "color-brand": "var(--brand)",
      "color-brand-text": "var(--brand-text)",
      "color-brand-hover": "var(--brand-hover)",
      "color-brand-ink": "var(--brand-ink)",
      "color-brand-tint": "var(--brand-tint)",
      "color-brand-tint-2": "var(--brand-tint-2)",
      "color-brand-tint-2-hover": "var(--brand-tint-2-hover)",
      "color-brand-tint-2-text": "var(--brand-tint-2-text)",
      "color-brand-graphic": "var(--brand-graphic)",
      "color-brand-graphic-text": "var(--brand-graphic-text)",
      "color-brand-50": "var(--brand-50)",
      "color-brand-100": "var(--brand-100)",
      "color-brand-200": "var(--brand-200)",
      "color-brand-300": "var(--brand-300)",
      "color-brand-400": "var(--brand-400)",
      "color-brand-500": "var(--brand-500)",
      "color-brand-600": "var(--brand-600)",
      "color-brand-700": "var(--brand-700)",
      "color-brand-800": "var(--brand-800)",
      "color-brand-900": "var(--brand-900)",
      "color-brand-950": "var(--brand-950)",
      "color-ok": "var(--ok)",
      "color-ok-fill": "var(--ok-fill)",
      "color-ok-fill-text": "var(--ok-fill-text)",
      "color-ok-tint": "var(--ok-tint)",
      "color-warn": "var(--warn)",
      "color-warn-fill": "var(--warn-fill)",
      "color-warn-fill-text": "var(--warn-fill-text)",
      "color-warn-tint": "var(--warn-tint)",
      "color-danger": "var(--danger)",
      "color-danger-fill": "var(--danger-fill)",
      "color-danger-fill-text": "var(--danger-fill-text)",
      "color-danger-tint": "var(--danger-tint)",
      "shadow-overlay": "var(--pyo-shadow-overlay)"
    },
    "light": {
      "bg": "#FAFAFA",
      "surface": "#FFFFFF",
      "surface-2": "#F2F2F3",
      "surface-3": "#E6E6E8",
      "text": "#111111",
      "text-2": "#5C5C5F",
      "text-3": "#6D6D71",
      "line": "#767676",
      "glow": "transparent",
      "scrim": "rgba(0, 0, 0, .32)",
      "skeleton": "#E6E6E8",
      "pyo-shadow-overlay": "0 4px 12px rgba(0, 0, 0, .08)"
    },
    "dark": {
      "bg": "#0C0C0C",
      "surface": "#161616",
      "surface-2": "#1F1F1F",
      "surface-3": "#2A2A2A",
      "text": "#F5F5F5",
      "text-2": "#A3A3A6",
      "text-3": "#8E8E92",
      "line": "#7A7A7E",
      "glow": "rgba(255, 255, 255, .06)",
      "scrim": "rgba(0, 0, 0, .56)",
      "skeleton": "#2A2A2A",
      "pyo-shadow-overlay": "none"
    }
  },
  "css": {
    "@utility one-line": {
      "white-space": "nowrap",
      "overflow": "hidden",
      "text-overflow": "ellipsis",
      "min-width": "0"
    },
    "@utility glow": {
      "box-shadow": "0 0 0 1px var(--glow)"
    },
    "@utility tabular": {
      "font-variant-numeric": "tabular-nums"
    }
  },
  "type": "registry:item"
}